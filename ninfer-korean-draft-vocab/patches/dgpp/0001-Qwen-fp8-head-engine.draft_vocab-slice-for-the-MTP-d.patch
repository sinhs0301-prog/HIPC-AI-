@@ -565,6 +570,18 @@ void QwenModel::lm_head_logits(const uint16_t* hidden, int rows, cudaStream_t st
     }
     return;
   }
+  if (globals_.lm_head_fp8.payload && head_dump_site_ == 1 && draft_slice_logits_ != nullptr &&
+      rows <= max_decode_rows_ && !last_row_only && compact_row < 0) {
+    // The draft's call over the vocabulary slice (engine.draft_vocab): the
+    // slice's logits, then scattered to their ids over a -inf row.
+    const int n = globals_.draft_vocab_count;
+    launch_scale_gemm_f32(hidden, static_cast<size_t>(H), globals_.draft_head_fp8.payload,
+                          globals_.draft_head_fp8.scales, draft_slice_logits_, rows, n, H, stream,
+                          static_cast<size_t>(n), fp8_head_mma_ ? dense_gemv_rows() + 1 : 0);
+    launch_draft_slice_scatter(draft_slice_logits_, globals_.draft_vocab_ids, n, rows,
+                               logits_ + static_cast<size_t>(output_row) * lm_vocab_count_, lm_vocab_count_, stream);
+    return;
+  }
   if (globals_.lm_head_fp8.payload)
     launch_scale_gemm_f32(hidden, static_cast<size_t>(H), globals_.lm_head_fp8.payload,
                           globals_.lm_head_fp8.scales, logits_ + static_cast<size_t>(output_row) * lm_vocab_count_, rows, lm_vocab_count_, H, stream,
