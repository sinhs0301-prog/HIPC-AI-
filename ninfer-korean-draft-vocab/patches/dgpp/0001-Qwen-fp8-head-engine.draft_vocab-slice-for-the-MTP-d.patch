diff --git a/src/kernels/draft_slice.cu b/src/kernels/draft_slice.cu
new file mode 100644
index 0000000..d7f80bd
--- /dev/null
+++ b/src/kernels/draft_slice.cu
@@ -0,0 +1,27 @@
+#include "kernels/draft_slice.hpp"
+#include <cmath>
+
+namespace dgpp {
+namespace {
+__global__ void draft_fill_kernel(float* out, size_t total) {
+  for (size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x; i < total;
+       i += static_cast<size_t>(gridDim.x) * blockDim.x)
+    out[i] = -INFINITY;
+}
+__global__ void draft_scatter_kernel(const float* slice, const int32_t* ids, int n, int rows, float* out, int V) {
+  const size_t total = static_cast<size_t>(n) * rows;
+  for (size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x; i < total;
+       i += static_cast<size_t>(gridDim.x) * blockDim.x) {
+    const size_t r = i / n, j = i % n;
+    out[r * static_cast<size_t>(V) + ids[j]] = slice[i];
+  }
+}
+}  // namespace
+
+void launch_draft_slice_scatter(const float* slice, const int32_t* ids, int n, int rows, float* out, int V,
+                                cudaStream_t stream) {
+  if (rows <= 0) return;
+  draft_fill_kernel<<<192, 256, 0, stream>>>(out, static_cast<size_t>(rows) * V);
+  draft_scatter_kernel<<<192, 256, 0, stream>>>(slice, ids, n, rows, out, V);
+}
+}  // namespace dgpp
diff --git a/src/kernels/draft_slice.hpp b/src/kernels/draft_slice.hpp
new file mode 100644
index 0000000..281754e
--- /dev/null
+++ b/src/kernels/draft_slice.hpp
@@ -0,0 +1,9 @@
+#pragma once
+#include <cstdint>
+#include <cuda_runtime.h>
+
+namespace dgpp {
+// out[r][v] = -inf for every v, then out[r][ids[j]] = slice[r][j] (row stride V).
+void launch_draft_slice_scatter(const float* slice, const int32_t* ids, int n, int rows, float* out, int V,
+                                cudaStream_t stream);
+}  // namespace dgpp
