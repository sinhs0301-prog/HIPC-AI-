diff --git a/tools/convert/proposal.py b/tools/convert/proposal.py
index e8e378e..3e52e4f 100644
--- a/tools/convert/proposal.py
+++ b/tools/convert/proposal.py
@@ -42,6 +42,36 @@ def select_shortlist(total: np.ndarray, n: int, force_include=()) -> np.ndarray:
     return np.ascontiguousarray(selected[np.argsort(-counts[selected], kind="stable")])
 
 
+def load_token_ids(path: str | Path) -> np.ndarray:
+    """Read an explicit proposal vocabulary: a 1-D integer .npy, or a text file of
+    whitespace/comma separated token IDs (``#`` starts a comment)."""
+    path = Path(path)
+    if path.suffix == ".npy":
+        ids = np.load(path, allow_pickle=False)
+        if ids.ndim != 1 or ids.dtype.kind not in "iu":
+            raise ValueError("proposal IDs .npy must be a 1-D integer array")
+    else:
+        words = []
+        for line in path.read_text().splitlines():
+            words += line.split("#", 1)[0].replace(",", " ").split()
+        ids = np.array([int(w) for w in words], dtype=np.int64)
+    return ids.astype(np.int64)
+
+
+def explicit_shortlist(ids, token_count: int, force_include=()) -> np.ndarray:
+    """Keep the given IDs in first-seen order, append missing forced IDs."""
+    ids = np.asarray(ids, dtype=np.int64)
+    if ids.size == 0:
+        raise ValueError("proposal ID list is empty")
+    if ids.min() < 0 or ids.max() >= token_count:
+        raise ValueError("proposal IDs must lie in the public token domain")
+    seen = dict.fromkeys(ids.tolist())
+    for token_id in sorted(int(i) for i in force_include):
+        if 0 <= token_id < token_count:
+            seen.setdefault(token_id)
+    return np.ascontiguousarray(np.fromiter(seen, dtype=np.int64))
+
+
